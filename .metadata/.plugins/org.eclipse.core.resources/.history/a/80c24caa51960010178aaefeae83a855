package com.subham.app1;

import org.json.JSONObject;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.client.RestTemplate;


@SpringBootApplication
@RestController
public class App1Application {

	private final RestTemplate restTemplate = new RestTemplate();
	private static final Logger logger = LoggerFactory.getLogger(App1Application.class);

	public static void main(String[] args) {
		SpringApplication.run(App1Application.class, args);
	}

	// Example: App1 GET -> calls App2 GET /hbt
	@GetMapping("/call-hbt")
	public String callHbt() {
		String url = "http://app2.local:8080/hbt"; // use container name "app2"
		String result = restTemplate.getForObject(url, String.class);
		logger.info("Request send from app1 to app2 for hbt check");
		logger.info("URL used: {}, Result: {}", url, result);
		return result;
	}

	// Example: App1 POST -> calls App2 POST /send
	@PostMapping("/call-send")
	public String callSend(@RequestBody String body) {
		String url = "http://app2.local:8080/send"; // use container name "app2"
		String response = restTemplate.postForObject(url, body, String.class);
		JSONObject jsonObject = new JSONObject(response); 
		logger.info("Request send from app1 to app2 for post call");
		logger.info("URL used: {}, Result: {}", url, jsonObject);
	}

}
